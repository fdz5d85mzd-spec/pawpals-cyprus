generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  name              String?
  username          String?   @unique
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  dateOfBirth       DateTime?
  acceptedTermsAt   DateTime?
  emailUpdatesOptIn Boolean   @default(false)

  // 24h free-Pro trial window, set once at signup — grants PRO access in
  // lib/auth.ts's jwt callback until it elapses, without ever touching
  // Subscription (that model stays reserved for real Stripe state).
  trialEndsAt DateTime?

  // Referral program: every user gets a shareable code; referredById links
  // a signup back to whoever's link they used. A reward is only granted
  // (see ReferralReward) once the referred user actually pays.
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  comments      MatchComment[]
  reviews       SiteReview[]
  suggestions   Suggestion[]
  redeemedCodes PromoCode[]
  rewardsEarned ReferralReward[] @relation("RewardsEarned")
  rewardCaused  ReferralReward?  @relation("RewardCaused")
  picks         UserPick[]
  pushSubscriptions PushSubscription[]

  // Formal cash-commission partner program — separate from the
  // friend-discount Referral system above (that pays a discount on the
  // referrer's OWN bill; this pays real money to a partner for signups
  // they bring in). `affiliate` is only set once a user opts in.
  affiliate             Affiliate?
  referredByAffiliateId String?
  referredByAffiliate   Affiliate?            @relation("AffiliateSignups", fields: [referredByAffiliateId], references: [id])
  commissionsGenerated  AffiliateCommission[] @relation("CommissionsFromUser")

  createdAt DateTime @default(now())
}

// One row per successful referral conversion (the referred user's first
// paid Stripe subscription). percentOff is applied as a one-cycle discount
// on the referrer's next invoice — see app/api/stripe/webhook/route.ts.
model ReferralReward {
  id             String    @id @default(cuid())
  referrerId     String
  referrer       User      @relation("RewardsEarned", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String    @unique
  referredUser   User      @relation("RewardCaused", fields: [referredUserId], references: [id], onDelete: Cascade)
  percentOff     Int
  stripeCouponId String?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Affiliate / partner program — real cash commissions, tracked in cents.
// ---------------------------------------------------------------------------

model Affiliate {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String   @unique
  commissionPercent Int      @default(20)
  createdAt         DateTime @default(now())

  referredSignups User[]                @relation("AffiliateSignups")
  clicks          AffiliateClick[]
  commissions     AffiliateCommission[]
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
}

enum CommissionStatus {
  PENDING
  PAID
}

// One row per commissionable payment — the affiliate's first referred
// checkout AND every recurring renewal after it, not just a one-time
// signup bonus (that's what makes "creating members" actually pay off
// over time). Amount stored in cents to avoid float rounding. stripeEventId
// dedupes against Stripe's at-least-once webhook delivery. Actual payout
// (bank transfer / PayPal) happens outside this system for now — `status`
// just records whether a commission has been settled yet.
model AffiliateCommission {
  id             String           @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String
  referredUser   User             @relation("CommissionsFromUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String           @default("eur")
  plan           String
  stripeEventId  String           @unique
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  status               String    @default("inactive") // active | past_due | canceled | inactive
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Football data cache (populated from API-Football, refreshed by the cron jobs)
// ---------------------------------------------------------------------------

model League {
  id      Int      @id // API-Football league id
  name    String
  country String
  season  Int
  logoUrl String?
  teams   Team[]
  fixtures Fixture[]
  standings Standing[]
}

model Team {
  id            Int      @id // API-Football team id
  name          String
  shortName     String
  logoUrl       String?
  leagueId      Int
  league        League   @relation(fields: [leagueId], references: [id])
  leaguePos     Int?
  avgGoalsFor   Float?
  avgGoalsAgainst Float?
  form          String[] @default([]) // ["W","D","L",...] most recent last
  statsUpdatedAt DateTime?

  keyPlayers    Player[]
  homeFixtures  Fixture[] @relation("HomeTeam")
  awayFixtures  Fixture[] @relation("AwayTeam")
  standings     Standing[]
}

// Full league table row, refreshed daily by /api/cron/sync-standings.
// Separate from Team.leaguePos (which is only the rank, opportunistically
// updated whenever a prediction is frozen for that team).
model Standing {
  id           String   @id @default(cuid())
  leagueId     Int
  league       League   @relation(fields: [leagueId], references: [id])
  teamId       Int
  team         Team     @relation(fields: [teamId], references: [id])
  rank         Int
  points       Int
  played       Int
  win          Int
  draw         Int
  lose         Int
  goalsFor     Int
  goalsAgainst Int
  form         String?
  updatedAt    DateTime @updatedAt

  @@unique([leagueId, teamId])
}

model Player {
  id       Int     @id // API-Football player id
  teamId   Int
  team     Team    @relation(fields: [teamId], references: [id])
  name     String
  role     String
  goals    Int     @default(0)
  apps     Int     @default(0)
  status   String  @default("fit") // fit | doubtful | injured
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model Fixture {
  id         Int           @id // API-Football fixture id
  leagueId   Int
  league     League        @relation(fields: [leagueId], references: [id])
  homeTeamId Int
  homeTeam   Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoff    DateTime
  venue      String?
  status     FixtureStatus @default(SCHEDULED)
  homeGoals  Int?
  awayGoals  Int?
  htHomeGoals Int?
  htAwayGoals Int?

  prediction PredictionSnapshot?
  comments   MatchComment[]
  userPicks  UserPick[]

  @@index([kickoff])
}

enum PickChoice {
  HOME
  DRAW
  AWAY
}

// A logged-in user's own 1X2 guess on a fixture, made before kickoff —
// the persisted, cross-match version of the homepage's stateless
// InstinctQuiz. `hit` stays null until settle-results grades the real
// result; that's what powers both the personal accuracy tracker on
// /account and the /leaderboard ranking.
model UserPick {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixtureId Int
  fixture   Fixture    @relation(fields: [fixtureId], references: [id])
  pick      PickChoice
  hit       Boolean?
  createdAt DateTime   @default(now())

  @@unique([userId, fixtureId])
}

// One row per browser/device the user enabled push notifications on
// (they can have several). Sent the daily pick-of-day alongside the
// existing email digest — see app/api/cron/send-daily-digest/route.ts.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Community: per-match comments, site reviews, suggestions, helpdesk
// ---------------------------------------------------------------------------

model MatchComment {
  id        String   @id @default(cuid())
  fixtureId Int
  fixture   Fixture  @relation(fields: [fixtureId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([fixtureId, createdAt])
}

// Site-wide star rating, shown on a public /reviews page (average + list).
model SiteReview {
  id        String   @id @default(cuid())
  userId    String   @unique // one review per user, editable
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  body      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SuggestionStatus {
  OPEN
  PLANNED
  DONE
  DECLINED
}

model Suggestion {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String           @db.Text
  status    SuggestionStatus @default(OPEN)
  createdAt DateTime         @default(now())
}

// Contact-form submissions. No auth required — anyone can reach support.
model HelpdeskMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Admin-managed sponsor/ad boxes for otherwise-empty layout space (e.g. the
// homepage sidebar). `slotKey` identifies which spot on the site a banner
// belongs to; `position` orders banners within that slot and doubles as a
// stable "box #1/2/3" identity so the UI always renders a fixed number of
// boxes (filled or empty) rather than a variable-length list.
model AdBanner {
  id        String   @id @default(cuid())
  slotKey   String
  position  Int
  imageUrl  String
  linkUrl   String
  updatedAt DateTime @updatedAt

  @@unique([slotKey, position])
}

// A prediction "frozen" ~24h before kickoff. Immutable once created — the
// scheduler only ever inserts one snapshot per fixture (enforced by the
// unique fixtureId).
model PredictionSnapshot {
  id               String    @id @default(cuid())
  fixtureId        Int       @unique
  fixture          Fixture   @relation(fields: [fixtureId], references: [id])
  frozenAt         DateTime  @default(now())

  lambdaHome       Float
  lambdaAway       Float
  winHome          Int
  draw             Int
  winAway          Int
  doubleChance     Json
  bttsYes          Int
  ouLines          Json
  scores           Json
  asianHandicap    Json
  htft             String
  htftConfidence   Int
  corners          Int
  cornersOver95    Int
  cards            Float
  cardsOver45      Int
  scorer           Json?
  confidence       Int
  matrix           Json

  results          PredictionResult[]
}

enum Market {
  ONE_X_TWO
  DOUBLE_CHANCE
  ASIAN_HANDICAP
  HT_FT
  OVER_UNDER_2_5
  BTTS
  CORRECT_SCORE
}

// One row per market per fixture, computed once the fixture is FINISHED and
// the actual result has been fetched. This is what the accuracy tracker
// aggregates over.
model PredictionResult {
  id           String    @id @default(cuid())
  predictionId String
  prediction   PredictionSnapshot @relation(fields: [predictionId], references: [id])
  market       Market
  predicted    String
  predictedPct Int
  actual       String
  hit          Boolean
  settledAt    DateTime  @default(now())

  @@unique([predictionId, market])
}

// Free-Pro-access codes, redeemed once each. Grants PRO directly on
// Subscription without going through Stripe (no card required).
model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  redeemedByUserId String?
  redeemedBy       User?     @relation(fields: [redeemedByUserId], references: [id])
  redeemedAt       DateTime?
  createdAt        DateTime  @default(now())
}
