# Postgres (Supabase / Neon) — used by Prisma
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Neon/Supabase pooled connections may need a second direct URL for migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — in production, https://skorama.xyz
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# API-Football (api-football.com / RapidAPI)
API_FOOTBALL_KEY="your-api-football-key"
API_FOOTBALL_HOST="v3.football.api-sports.io"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend (daily email digest)
RESEND_API_KEY="re_..."
# Only set this once skorama.xyz shows "Verified" in the Resend dashboard —
# until then, leave unset and it falls back to Resend's onboarding domain.
RESEND_FROM_EMAIL="Skorama <digest@skorama.xyz>"

# Protects the cron endpoints from being called by anyone but Vercel Cron
CRON_SECRET="generate-a-long-random-string"

# In production, https://skorama.xyz
NEXT_PUBLIC_APP_URL="http://localhost:3000"
